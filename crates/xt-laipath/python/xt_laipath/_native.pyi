from typing import Sequence

__version__: str
LAI_MAX: float

class NumericalError(ArithmeticError):
    """Numerical failure retaining the underlying GSL error code and operation name."""
    code: int
    operation: str

class Histogram:
    def __init__(self, bin: Sequence[float], range: Sequence[float]) -> None: ...
    @property
    def bin(self) -> list[float]: ...
    @property
    def range(self) -> list[float]: ...
    def probability(self, value: float) -> float: ...

class Point:
    def __init__(self, x: float, y: float) -> None: ...
    @property
    def x(self) -> float: ...
    @property
    def y(self) -> float: ...
    def euclidean(self, other: Point) -> float: ...
    def haversine(self, other: Point) -> float: ...
    def vincenty(self, other: Point) -> float: ...

def histogram_stats(data: Sequence[float], num_bins: int, a: float = 0.0, b: float = 1.0) -> Histogram: ...
def calc_eff_lai(gap_fraction: float, zenith: float = 0.0, g: float = 0.5) -> float: ...
def calc_lai_path(histogram: Histogram, gap_fraction: float, zenith: float = 0.0, g: float = 0.5) -> float: ...
def calc_lai_ellipse(gap_fraction: float, zenith: float = 0.0, g: float = 0.5) -> float: ...
def calc_laie2lai_ellipse(eff_lai: float, zenith: float = 0.0, g: float = 0.5) -> float: ...
